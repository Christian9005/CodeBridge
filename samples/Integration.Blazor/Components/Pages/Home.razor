@page "/"

<PageTitle>CodeBridge dashboard</PageTitle>

<header class="cb-page-head">
    <h1>My board</h1>
    <p>Every card talks to the same shared connection. Change the pins to match your wiring.</p>
</header>

<div class="cb-grid">
    <BoardStatus />
    <PinToggle Pin="2" Label="Built-in LED" />
    <PwmSlider Pin="4" Label="Lamp brightness" />
    <AnalogGauge Pin="34" Label="Light sensor" ScaledMax="100" Unit="%" />
    <div class="cb-wide">
        <SensorChart Pin="34" Label="Light sensor history" ScaledMax="100" Unit="%" Interval="250" />
    </div>
</div>
