@inherits CodeBridgeComponentBase

<div class="cb-card">
    <div class="cb-head">
        <div class="cb-title">@(Label ?? $"PWM {Pin}")</div>
        <span class="cb-pin">GPIO @Pin</span>
    </div>
    <div class="cb-value cb-readout">@Percent<span class="cb-unit">% duty</span></div>
    <input class="cb-range" type="range" min="0" max="255" value="@_duty" style="--fill:@(Percent)%" aria-label="@(Label ?? $"PWM {Pin}")" aria-valuetext="@Percent percent"
           @oninput="OnInput" @onchange="OnChangeAsync" />
    <div class="cb-scale cb-readout"><span>0</span><span>@_duty / 255</span><span>255</span></div>
    @if (Error is not null)
    {
        <div class="cb-error" role="alert">@Error</div>
    }
</div>

@code {
    /// <summary>A PWM-capable GPIO (LED brightness, motor speed...).</summary>
    [Parameter, EditorRequired] public int Pin { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public int FrequencyHz { get; set; } = 5000;

    [Parameter] public EventCallback<int> OnChanged { get; set; }

    private int _duty;

    private int Percent => (int)Math.Round(_duty * 100.0 / 255);

    // While dragging only the picture follows; the board is written when the user lets go, so a drag never floods it with commands.
    private void OnInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var duty))
            _duty = Math.Clamp(duty, 0, 255);
    }

    private async Task OnChangeAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var duty))
            return;

        try
        {
            _duty = Math.Clamp(duty, 0, 255);
            await Board.WritePwmAsync(Pin, _duty, FrequencyHz);
            Error = null;
            await OnChanged.InvokeAsync(_duty);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }
}
