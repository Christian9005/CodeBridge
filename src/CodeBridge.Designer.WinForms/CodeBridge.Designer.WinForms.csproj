<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>CodeBridge.Designer.WinForms</PackageId>
    <Description>Native WinForms Toolbox controls and visual designer for CodeBridge flows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeBridge.FlowHost" />
    <InternalsVisibleTo Include="CodeBridge.Designer.WinForms.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeBridge.ESP32\CodeBridge.ESP32.csproj" />
    <ProjectReference Include="..\CodeBridge.Flow\CodeBridge.Flow.csproj" />
    <ProjectReference Include="..\CodeBridge.Transport\CodeBridge.Transport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\CodeBridgeFlowControl.bmp" LogicalName="CodeBridge.Designer.WinForms.Resources.CodeBridgeFlowControl.bmp" />
    <EmbeddedResource Include="Resources\CodeBridgeEsp32Component.bmp" LogicalName="CodeBridge.Designer.WinForms.Resources.CodeBridgeEsp32Component.bmp" />
  </ItemGroup>

  <!-- Ship firmware sources + prebuilt ESP32 binaries so flashing works without the repo checked out. -->
  <ItemGroup>
    <None Include="..\..\firmware\esp32-bridge\platformio.ini" Pack="true" PackagePath="firmware\esp32-bridge\" Visible="false" />
    <None Include="..\..\firmware\esp32-bridge\src\main.cpp" Pack="true" PackagePath="firmware\esp32-bridge\src\" Visible="false" />
    <None Include="..\..\firmware\arduino-uno-bridge\CodeBridgeArduinoUno\*.ino" Pack="true" PackagePath="firmware\arduino-uno-bridge\CodeBridgeArduinoUno\" Visible="false" />
    <None Include="..\..\firmware\prebuilt\**\*.bin" Pack="true" PackagePath="firmware\prebuilt\" Visible="false" />
    <None Include="build\CodeBridge.Designer.WinForms.targets" Pack="true" PackagePath="build\" Visible="false" />
  </ItemGroup>

</Project>
