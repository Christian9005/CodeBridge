<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>CodeBridge.VisualStudio</RootNamespace>
    <AssemblyName>CodeBridge.VisualStudio</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DeployExtension>false</DeployExtension>
    <PackageId>CodeBridge.VisualStudio</PackageId>
    <IsPackable>false</IsPackable>
    <!-- The editor is WPF code that only ever runs on the Visual Studio UI thread; these analyzers flag every caller of the UI-thread helpers. -->
    <NoWarn>$(NoWarn);VSTHRD010;VSTHRD110;VSTHRD100;VSTHRD200;VSTHRD012;VSTHRD001;VSTHRD003;VSSDK007</NoWarn>
    <Description>Visual Studio extension shell for CodeBridge WinForms toolbox integration.</Description>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.10.40170" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ProjectTemplates\**" />
    <Compile Remove="ItemTemplates\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="Commands\CodeBridgeCommands.vsct">
      <ResourceName>CodeBridgeCommands.CTMENU</ResourceName>
    </VSCTCompile>
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="Assets\toolbox-components.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Assets\toolbox-components.schema.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Assets\CodeBridgeIcon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Assets\CodeBridgePreview.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <VSTemplate Include="ProjectTemplates\**\*.vstemplate">
      <OutputSubPath>ProjectTemplates</OutputSubPath>
    </VSTemplate>
    <Content Include="ProjectTemplates\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <VSTemplate Include="ItemTemplates\**\*.vstemplate">
      <OutputSubPath>ItemTemplates</OutputSubPath>
    </VSTemplate>
    <Content Include="ItemTemplates\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Assets\catalog.*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- Out-of-process helper (board access, firmware upload, run), zipped by build\pack.ps1 and unpacked on first use -->
    <Content Include="..\..\artifacts\FlowHost.zip">
      <Link>FlowHost.zip</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\artifacts\packages\CodeBridge.*.$(Version).nupkg" Exclude="..\..\artifacts\packages\CodeBridge.VisualStudio.*.nupkg;..\..\artifacts\packages\CodeBridge.Hosting.*.nupkg;..\..\artifacts\packages\CodeBridge.Blazor.*.nupkg;..\..\artifacts\packages\CodeBridge.HomeAssistant.*.nupkg;..\..\artifacts\packages\CodeBridge.Mcp.*.nupkg;..\..\artifacts\packages\CodeBridge.PlatformIO.*.nupkg">
      <Link>Packages\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <!-- Compiled sample code shown by the CodeBridge Tour ("The same thing in C#"). Copied under the names the tour expects. -->
  <Target Name="PrepareTourCode" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_TourDir>$(MSBuildProjectDirectory)\obj\TourCode\</_TourDir>
      <_Samples>$(MSBuildThisFileDirectory)..\..\samples\</_Samples>
    </PropertyGroup>
    <ItemGroup>
      <_TourExamples Include="$(_Samples)TourSnippets\Example*.cs" />
    </ItemGroup>
    <MakeDir Directories="$(_TourDir)" />
    <Copy SourceFiles="@(_TourExamples)" DestinationFolder="$(_TourDir)" />
    <Copy SourceFiles="$(_Samples)Integration.Console\Program.cs" DestinationFiles="$(_TourDir)Console_Program.cs" />
    <Copy SourceFiles="$(_Samples)Integration.Api\Program.cs" DestinationFiles="$(_TourDir)Api_Program.cs" />
    <Copy SourceFiles="$(_Samples)Integration.WindowsService\Program.cs" DestinationFiles="$(_TourDir)Service_Program.cs" />
    <Copy SourceFiles="$(_Samples)Integration.WindowsService\SensorLoggerWorker.cs" DestinationFiles="$(_TourDir)Service_Worker.cs" />
    <ItemGroup>
      <_TourOutput Include="$(_TourDir)*.cs" />
      <Content Include="@(_TourOutput)">
        <Link>Tour\Code\%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
    </ItemGroup>
  </Target>

  <!-- A VSIX without the embedded NuGet packages cannot install the toolbox components: fail the build instead of shipping it. -->
  <Target Name="EnsureCodeBridgePackagesEmbedded" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_RequiredPackage Include="CodeBridge.Core;CodeBridge.Transport;CodeBridge.ESP32;CodeBridge.Flow;CodeBridge.Designer.WinForms" />
    </ItemGroup>
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\artifacts\FlowHost.zip')"
           Text="Missing artifacts\FlowHost.zip. Run build\pack.ps1 -Vsix (it publishes and zips the FlowHost) before building the VSIX in Release." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\artifacts\packages\%(_RequiredPackage.Identity).$(Version).nupkg')"
           Text="Missing artifacts\packages\%(_RequiredPackage.Identity).$(Version).nupkg. Run build\pack.ps1 before building the VSIX in Release." />
  </Target>

</Project>
