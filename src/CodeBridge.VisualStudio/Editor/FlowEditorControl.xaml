<UserControl x:Class="CodeBridge.VisualStudio.Editor.FlowEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodeBridge.VisualStudio.Editor"
             Background="{DynamicResource VsWindowBackground}"
             FontFamily="Segoe UI"
             FontSize="12"
             Focusable="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="EditorTheme.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- Dark defaults; VsTheme replaces the colors with the active Visual Studio theme at runtime. -->
        <SolidColorBrush x:Key="VsWindowBackground" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="VsToolWindowBackground" Color="#252526"/>
        <SolidColorBrush x:Key="VsToolWindowHeader" Color="#2d2d30"/>
        <SolidColorBrush x:Key="VsToolWindowBorder" Color="#3f3f46"/>
        <SolidColorBrush x:Key="VsToolWindowText" Color="#f1f1f1"/>
        <SolidColorBrush x:Key="VsGrayText" Color="#999999"/>
        <SolidColorBrush x:Key="VsInputBackground" Color="#333337"/>
        <SolidColorBrush x:Key="VsInputBorder" Color="#434346"/>
        <SolidColorBrush x:Key="VsHighlight" Color="#007acc"/>
        <SolidColorBrush x:Key="VsCanvasGridMajor" Color="#2d2d30"/>
        <SolidColorBrush x:Key="VsCanvasGridMinor" Color="#232326"/>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource VsToolWindowText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsInputBackground}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource VsInputBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource VsHighlight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="OutputSplitterRow" Height="Auto"/>
            <RowDefinition x:Name="OutputRow" Height="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Toolbar ============ -->
        <Border Grid.Row="0" x:Name="ToolbarBorder" Background="{DynamicResource VsToolWindowHeader}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsToolWindowBorder}" Padding="6,4">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Board" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource VsGrayText}"/>
                    <ComboBox x:Name="BoardCombo" Width="130" Height="23" ToolTip="Target board. The block catalog and pin lists follow this choice."/>
                    <TextBlock Text="Port" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{DynamicResource VsGrayText}"/>
                    <ComboBox x:Name="PortCombo" Width="190" Height="23" IsEditable="True" ToolTip="USB serial port (COM3) or the board's IP address for Wi-Fi."/>
                    <Button x:Name="RefreshPortsButton" Style="{StaticResource ToolbarButton}" ToolTip="Refresh ports"/>

                    <Rectangle Width="1" Margin="8,2" Fill="{DynamicResource VsToolWindowBorder}"/>

                    <Button x:Name="ConnectButton" Style="{StaticResource ToolbarButton}" ToolTip="Test the connection with the board and read its firmware version"/>
                    <Button x:Name="UploadButton" Style="{StaticResource ToolbarButton}" ToolTip="Install the CodeBridge firmware on the board (bootloader + firmware)"/>
                    <Button x:Name="WifiButton" Style="{StaticResource ToolbarButton}" ToolTip="Wi-Fi setup: connect an ESP32 to your network and pair it (needs the USB cable once)"/>
                    <Button x:Name="HomeAssistantButton" Style="{StaticResource ToolbarButton}" ToolTip="Home Assistant: show this flow's inputs and outputs in Home Assistant"/>

                    <Rectangle Width="1" Margin="8,2" Fill="{DynamicResource VsToolWindowBorder}"/>

                    <Button x:Name="RunButton" Style="{StaticResource ToolbarButton}" ToolTip="Run this flow on the board"/>
                    <Button x:Name="StopButton" Style="{StaticResource ToolbarButton}" ToolTip="Stop the running flow"/>
                    <CheckBox x:Name="LoopCheck" Content="Loop" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource VsToolWindowText}" ToolTip="Repeat the flow continuously until stopped"/>

                    <Rectangle Width="1" Margin="8,2" Fill="{DynamicResource VsToolWindowBorder}"/>

                    <Button x:Name="UndoButton" Style="{StaticResource ToolbarButton}" ToolTip="Undo (Ctrl+Z)"/>
                    <Button x:Name="RedoButton" Style="{StaticResource ToolbarButton}" ToolTip="Redo (Ctrl+Y)"/>
                    <Button x:Name="ArrangeButton" Style="{StaticResource ToolbarButton}" ToolTip="Arrange blocks left to right and tidy the wires"/>
                    <Button x:Name="ExportButton" Style="{StaticResource ToolbarButton}" ToolTip="Export this flow as C# code that uses the CodeBridge SDK"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource ToolbarButton}" ToolTip="Zoom out"/>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="42" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource VsGrayText}" ToolTip="Mouse wheel zooms. Middle button or Space + drag pans."/>
                    <Button x:Name="ZoomInButton" Style="{StaticResource ToolbarButton}" ToolTip="Zoom in"/>
                    <Button x:Name="FitButton" Style="{StaticResource ToolbarButton}" ToolTip="Fit all blocks in view"/>
                    <Rectangle Width="1" Margin="8,2" Fill="{DynamicResource VsToolWindowBorder}"/>
                    <Button x:Name="OutputButton" Style="{StaticResource ToolbarButton}" ToolTip="Show or hide the CodeBridge output panel"/>
                    <Button x:Name="MonitorButton" Style="{StaticResource ToolbarButton}" ToolTip="Open the serial monitor and plotter for the selected port"/>
                    <Button x:Name="BoardViewButton" Style="{StaticResource ToolbarButton}" ToolTip="Show or hide the board view: a live picture of the pins while the flow runs"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Main area ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" MaxWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- Toolbox -->
            <Grid Grid.Column="0" Background="{DynamicResource VsToolWindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource VsToolWindowHeader}" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsToolWindowBorder}">
                    <TextBlock Text="Toolbox" FontWeight="SemiBold" Foreground="{DynamicResource VsToolWindowText}" FontSize="11"/>
                </Border>

                <Border Grid.Row="1" Padding="6,6,6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsToolWindowBorder}">
                    <Grid>
                        <TextBox x:Name="ToolboxSearch" Padding="6,3" FontSize="11" TextChanged="OnToolboxSearchChanged"
                                 Background="{DynamicResource VsInputBackground}" Foreground="{DynamicResource VsToolWindowText}"
                                 BorderBrush="{DynamicResource VsInputBorder}" BorderThickness="1"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Search blocks..." Margin="8,4,0,0" Foreground="{DynamicResource VsGrayText}"
                                   FontSize="11" FontStyle="Italic" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <TreeView x:Name="Toolbox" Grid.Row="2" Background="Transparent" Foreground="{DynamicResource VsToolWindowText}" BorderThickness="0" Margin="0,4,0,0"
                          ToolTip="Drag a block onto the canvas, double-click it, or press Enter.">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="{DynamicResource VsToolWindowText}"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Margin" Value="0,1"/>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource VsToolWindowBorder}" ShowsPreview="False"/>

            <!-- Canvas: the grid lives in the ZoomBorder background so it stays infinite while panning/zooming -->
            <local:ZoomBorder x:Name="CanvasBorder" Grid.Column="2" ClipToBounds="True" AllowDrop="False">
                <local:ZoomBorder.Background>
                    <DrawingBrush x:Name="GridBrush" Viewport="0,0,100,100" ViewportUnits="Absolute" TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="{StaticResource VsWindowBackground}">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,100,100"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="{StaticResource VsCanvasGridMinor}" Thickness="1"/>
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="20,0" EndPoint="20,100"/>
                                            <LineGeometry StartPoint="40,0" EndPoint="40,100"/>
                                            <LineGeometry StartPoint="60,0" EndPoint="60,100"/>
                                            <LineGeometry StartPoint="80,0" EndPoint="80,100"/>
                                            <LineGeometry StartPoint="0,20" EndPoint="100,20"/>
                                            <LineGeometry StartPoint="0,40" EndPoint="100,40"/>
                                            <LineGeometry StartPoint="0,60" EndPoint="100,60"/>
                                            <LineGeometry StartPoint="0,80" EndPoint="100,80"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="{StaticResource VsCanvasGridMajor}" Thickness="1"/>
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="0,100"/>
                                            <LineGeometry StartPoint="0,0" EndPoint="100,0"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </local:ZoomBorder.Background>
                <Canvas x:Name="EditorCanvas" Background="Transparent"/>
            </local:ZoomBorder>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource VsToolWindowBorder}" ShowsPreview="False"/>

            <!-- Properties -->
            <Grid Grid.Column="4" Background="{DynamicResource VsToolWindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource VsToolWindowHeader}" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsToolWindowBorder}">
                    <TextBlock Text="Properties" FontWeight="SemiBold" Foreground="{DynamicResource VsToolWindowText}" FontSize="11"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                    <StackPanel x:Name="PropertiesContainer" Margin="12"/>
                </ScrollViewer>
                <GridSplitter x:Name="BoardSplitter" Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource VsToolWindowBorder}" ShowsPreview="False" Visibility="Collapsed"/>
                <Grid x:Name="BoardPanel" Grid.Row="3" Height="360" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource VsToolWindowHeader}" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsToolWindowBorder}">
                        <TextBlock Text="Board" FontWeight="SemiBold" Foreground="{DynamicResource VsToolWindowText}" FontSize="11"/>
                    </Border>
                    <local:BoardViewControl x:Name="BoardView" Grid.Row="1"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Output panel ============ -->
        <GridSplitter x:Name="OutputSplitter" Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource VsToolWindowBorder}" ShowsPreview="False" Visibility="Collapsed"/>
        <Grid x:Name="OutputPanel" Grid.Row="3" Background="{DynamicResource VsToolWindowBackground}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource VsToolWindowHeader}" Padding="10,3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsToolWindowBorder}">
                <DockPanel>
                    <Button x:Name="ClearOutputButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" ToolTip="Clear output"/>
                    <TextBlock Text="CodeBridge Output" FontWeight="SemiBold" Foreground="{DynamicResource VsToolWindowText}" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <TextBox x:Name="OutputText" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                     Background="{DynamicResource VsToolWindowBackground}" Foreground="{DynamicResource VsToolWindowText}" Padding="8,4"/>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="4" x:Name="StatusBorder" Background="{DynamicResource VsToolWindowHeader}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VsToolWindowBorder}" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="InfoText" DockPanel.Dock="Right" Foreground="{DynamicResource VsGrayText}" FontSize="11"/>
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#7a7a7a" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource VsToolWindowText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Ghost shown while a block is dragged out of the toolbox -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="5" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
