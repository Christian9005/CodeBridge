<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The template wizard fills in the version with the CodeBridge release this extension ships with. -->
    <PackageReference Include="CodeBridge.Designer.WinForms" Version="$codebridgeversion$" />
  </ItemGroup>

</Project>
