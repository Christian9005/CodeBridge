<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBridge.Designer.WinForms\CodeBridge.Designer.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The starter form is generated by the Visual Studio extension (net472). Its source is plain text, so the tests compile it here against the real library. -->
    <Compile Include="..\..\src\CodeBridge.VisualStudio\CodeBridgeStarterFormTemplate.cs" Link="Generated\CodeBridgeStarterFormTemplate.cs" />
    <Compile Include="..\..\src\CodeBridge.VisualStudio\CodeBridgeStarterFlow.cs" Link="Generated\CodeBridgeStarterFlow.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
